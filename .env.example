# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables. See README for setup steps.

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (type "Web application").
# Bundled into the app; a client ID is not a secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Server-only (no EXPO_PUBLIC_ prefix): free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Native iOS/Android builds only ---------------------------------------
# OAuth client ID of type "iOS" (enables the native Google Sign-In plugin).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Extra OAuth client IDs (e.g. Android), comma-separated, allowed to call /api/analyze.
# GOOGLE_ALLOWED_CLIENT_IDS=
# Where the API routes are hosted, e.g. https://your-app.vercel.app
# EXPO_PUBLIC_API_URL=
