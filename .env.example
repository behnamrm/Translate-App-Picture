# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API. Bundled into the app (safe to expose; RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (no EXPO_PUBLIC_ prefix): used by the /api/analyze route and never sent to clients.
OPENAI_API_KEY=

# Native builds only: where the API routes are hosted, e.g. https://your-app.vercel.app
# Leave empty for web and for local development.
EXPO_PUBLIC_API_URL=
